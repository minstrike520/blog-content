filters:
  and:
    - file.folder.endsWith("blog/posts")
    - file.ext == "md"
views:
  - type: table
    name: 全部
    order:
      - published
      - file.name
      - draft
      - kind
      - title
      - category
      - tags
      - description
    sort:
      - property: published
        direction: DESC
      - property: title
        direction: ASC
      - property: description
        direction: ASC
    indentProperties: false
    columnSize:
      note.published: 114
      file.name: 134
      note.draft: 23
      note.kind: 46
  - type: table
    name: IT筆記
    filters:
      and:
        - category == "IT筆記"
    order:
      - file.name
      - title
      - tags
      - published
      - category
    sort:
      - property: title
        direction: ASC
      - property: file.name
        direction: ASC
